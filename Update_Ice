.github/workflows/update-ice.yml
name: Update Plymouth ice

on:
  workflow_dispatch:
  schedule:
    - cron: "17 * * * *"

permissions:
  contents: write

jobs:
  update-plymouth:
    runs-on: ubuntu-latest
    timeout-minutes: 25

    steps:
      - name: Check out repository
        uses: actions/checkout@v6

      - name: Set up Python
        uses: actions/setup-python@v6
        with:
          python-version: "3.13"

      - name: Install Python dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt

      - name: Install Chromium for Playwright
        run: python -m playwright install --with-deps chromium

      - name: Fetch next 7 days of Plymouth ice
        shell: bash
        run: |
          mkdir -p data/plymouth
          export TZ=America/Chicago

          for OFFSET in 0 1 2 3 4 5 6; do
            DATE=$(date -d "+${OFFSET} day" +%F)
            echo "Fetching Plymouth availability for $DATE"

            python plymouth_ingest.py \
              --date "$DATE" \
              --min-minutes 60 \
              --out "data/plymouth/${DATE}.json"
          done

      - name: Commit updated ice data
        shell: bash
        run: |
          if [ -z "$(git status --porcelain -- data/plymouth)" ]; then
            echo "No availability changes."
            exit 0
          fi

          git config user.name "SportsSpace Ice Bot"
          git config user.email "actions@users.noreply.github.com"

          git add data/plymouth
          git commit -m "Update Plymouth ice availability"
          git push
